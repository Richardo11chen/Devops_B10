      "commit": "<C0_FULL_40_SHA>"
    },
    "build": {
      "command": "make",
      "verify_command": "make check"
    },
    "max_iterations": 5,
    "options": {
      "base_image": "ubuntu:22.04",
      "keep_intermediate_images": false
    }
  }
}
