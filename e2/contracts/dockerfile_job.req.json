{
  "schema_version": "1.0.0",
  "trace_id": "trace-010",
  "job_type": "DRAFT",
  "execution": {
    "mode": "ASYNC",
    "timeout_seconds": 1800,
    "resources": {
      "cpu": "2",
      "memory_mb": 2048
    }
  },
  "input": {
